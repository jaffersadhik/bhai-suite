# copy to .env and change these before the first "docker compose up"
MYSQL_ROOT_PASSWORD=Root_Change_Me_123
DB_USER=bmb
DB_PASS=App_Change_Me_123

# Local disk folders for the Docker volumes (ABSOLUTE paths, create them first with mkdir -p)
#   Linux:            /opt/bmb/mysql-data          /opt/bmb/backup
#   Windows (WSL2):   use a Linux path inside WSL, e.g. /home/<you>/bmb/mysql-data
MYSQL_DATA_DIR=/opt/bmb/mysql-data
MYSQL_BACKUP_DIR=/opt/bmb/backup

# ports
APP_PORT=8080
# MSchool port: 127.0.0.1:8081 = only this server (use with Caddy / SCHOOL_DOMAIN);  8081 = open directly  http://<server>:8081
SCHOOL_PORT=127.0.0.1:8081
# website port: 127.0.0.1:8082 = only this server (use with Caddy / WEBSITE_DOMAIN);  8082 = open directly  http://<server>:8082
WEBSITE_PORT=127.0.0.1:8082
# mHotel port: 127.0.0.1:8083 = only this server (use with Caddy / HOTEL_DOMAIN);  8083 = open directly  http://<server>:8083
HOTEL_PORT=127.0.0.1:8083
# Purchase Order Management port: 127.0.0.1:8084 = only this server (use with Caddy / PO_DOMAIN);  8084 = open directly
PO_PORT=127.0.0.1:8084
# PO budget rule: off | warn (default) | strict
POMGMT_BUDGET_ENFORCEMENT=warn
POMGMT_LOG_LEVEL=INFO   # DEBUG = trace each login (username, password length, hash match, pass/fail reason) in the container log; set back to INFO in production
MYSQL_PORT=3306

# mHotel: Swiggy/Zomato delivery webhook shared secret (empty = webhook disabled). The partner must send it in the X-Webhook-Secret header.
MHOTEL_WEBHOOK_SECRET=

# HTTPS (optional, needed for the phone-camera barcode scanner) - see docker-compose.https.yaml
# DOMAIN=billing.example.com
# SCHOOL_DOMAIN=school.example.com
# HOTEL_DOMAIN=hotel.example.com
# PO_DOMAIN=purchase.example.com
# WEBSITE_DOMAIN=www.example.in            (company website; several names: "example.in, www.example.in")
# The domain name decides the application: DOMAIN -> MBill, SCHOOL_DOMAIN -> MSchool, HOTEL_DOMAIN -> mHotel, PO_DOMAIN -> Purchase, WEBSITE_DOMAIN -> website (all in one Tomcat)
