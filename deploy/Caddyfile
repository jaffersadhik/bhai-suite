# Used by docker-compose.https.yaml.  ONE container "app" = ONE Tomcat = MBill :8080, MSchool :8081, website :8082 - the DOMAIN name decides which one a visitor gets.
#   DOMAIN         (required)  Bhai Mobile Billing  -> app:8080
#   SCHOOL_DOMAIN  (optional)  MSchool              -> app:8081   e.g. school.example.com (DNS A record -> this server)
#   WEBSITE_DOMAIN (optional)  Meeran Technologies website -> app:8082  e.g. www.example.in  (several names: "example.in, www.example.in")
# When SCHOOL_DOMAIN / WEBSITE_DOMAIN is not set, that site is served on a plain port (:8081 / :8082) inside the Caddy container only (not published).
# Caddy overwrites any X-Forwarded-For sent by a visitor with the real client address - the apps rely on that for the "Your IP" footer and the IP block.
{$DOMAIN} {
	reverse_proxy app:8080
}

{$SCHOOL_DOMAIN} {
	reverse_proxy app:8081
}

{$WEBSITE_DOMAIN} {
	reverse_proxy app:8082
}
